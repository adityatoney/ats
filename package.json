{
  "name": "aegis-trader",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev:server": "pnpm --filter @aegis/server dev",
    "dev:web": "pnpm --filter @aegis/web dev",
    "dev:runtime": "cd packages/runtime && uv run uvicorn aegis_runtime.api.app:app --reload --port 8000",
    "lint": "turbo lint",
    "lint:py": "cd packages/runtime && uv run ruff check src/ tests/",
    "format:py": "cd packages/runtime && uv run ruff format src/ tests/",
    "strategy:sweep": "python scripts/sweep_pinescript_strategies.py",
    "test": "turbo test",
    "test:py": "cd packages/runtime && uv run pytest tests/ -v",
    "rebuild": "./scripts/rebuild.sh",
    "rebuild:runtime": "./scripts/rebuild.sh runtime",
    "rebuild:server": "./scripts/rebuild.sh server",
    "rebuild:web": "./scripts/rebuild.sh web",
    "docker:up": "docker compose up -d",
    "docker:up:build": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose down && docker compose up -d --build",
    "convex:dev": "npx convex dev",
    "convex:deploy": "npx convex deploy",
    "convex:seed": "npx convex run seed:seedDatabase",
    "migrate:to-convex": "npx tsx scripts/migrate-to-convex.ts",
    "verify:migration": "npx tsx scripts/verify-migration.ts",
    "build": "turbo build"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "convex": "^1.34.0"
  }
}
