//@version=5                                                                                                                                                                                             
strategy("MA Crossover - AegisTrader Run 2448a44c",                                     
     overlay=true,
     initial_capital=1000000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=50,
     commission_type=strategy.commission.cash_per_contract,
     commission_value=0.01,
     slippage=1)

// Parameters matching AegisTrader config
fast_length = input.int(20, "Fast SMA Length")
slow_length = input.int(50, "Slow SMA Length")
max_drawdown_pct = input.float(10.0, "Max Drawdown %")

// Calculate SMAs
sma_fast = ta.sma(close, fast_length)
sma_slow = ta.sma(close, slow_length)

// Plot SMAs
plot(sma_fast, "SMA 20", color=color.blue, linewidth=2)
plot(sma_slow, "SMA 50", color=color.orange, linewidth=2)

// Crossover signals
bull_cross = ta.crossover(sma_fast, sma_slow)
bear_cross = ta.crossunder(sma_fast, sma_slow)

// Drawdown risk gate (track high water mark)
var float high_water_mark = strategy.initial_capital
high_water_mark := math.max(high_water_mark, strategy.equity)
current_drawdown = high_water_mark > 0 ? (high_water_mark - strategy.equity) / high_water_mark : 0.0
risk_ok = current_drawdown < (max_drawdown_pct / 100.0)

// Strategy entries (only if risk gate passes)
if bull_cross and risk_ok
    strategy.entry("Long", strategy.long)

if bear_cross and risk_ok
    strategy.entry("Short", strategy.short)

// Visual signals
plotshape(bull_cross and risk_ok, "Buy Signal", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(bear_cross and risk_ok, "Sell Signal", shape.triangledown, location.abovebar, color.red, size=size.small)

// Drawdown warning background
bgcolor(current_drawdown >= (max_drawdown_pct / 100.0) ? color.new(color.red, 90) : na)