//@version=5
// AegisTrader Validation Script — Run 3193ef95 (AAPL, 2022-01-01 to 2024-12-31, $100K)
// Apply to AAPL daily chart. Set Properties > Date Range: 2022-01-01 to 2024-12-31
// Compare TradingView's Performance Summary with AegisTrader metrics:
//   AegisTrader: 8 round-trips, +17.8% return, 37.5% win rate, PF 3.40, MaxDD 14.6%
strategy("AegisTrader Validation — MA Crossover Long-Only",
     overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=50,
     commission_type=strategy.commission.cash_per_contract,
     commission_value=0.01,
     slippage=1,
     process_orders_on_close=false)  // Fill on next bar open (matches AegisTrader)

// Parameters
fast_length = input.int(20, "Fast SMA Length")
slow_length = input.int(50, "Slow SMA Length")
max_drawdown_pct = input.float(10.0, "Max Drawdown %")

// Calculate SMAs
sma_fast = ta.sma(close, fast_length)
sma_slow = ta.sma(close, slow_length)

// Plot SMAs
plot(sma_fast, "SMA 20", color=color.blue, linewidth=2)
plot(sma_slow, "SMA 50", color=color.orange, linewidth=2)

// Crossover signals
bull_cross = ta.crossover(sma_fast, sma_slow)
bear_cross = ta.crossunder(sma_fast, sma_slow)

// Drawdown risk gate
var float high_water_mark = strategy.initial_capital
high_water_mark := math.max(high_water_mark, strategy.equity)
current_drawdown = high_water_mark > 0 ? (high_water_mark - strategy.equity) / high_water_mark : 0.0
risk_ok = current_drawdown < (max_drawdown_pct / 100.0)

// Long-only: buy on bullish cross, close on bearish cross
if bull_cross and risk_ok
    strategy.entry("Long", strategy.long)

if bear_cross
    strategy.close("Long")

// Visual signals
plotshape(bull_cross and risk_ok, "Buy", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(bear_cross, "Sell", shape.triangledown, location.abovebar, color.red, size=size.small)

// Drawdown background
bgcolor(current_drawdown >= (max_drawdown_pct / 100.0) ? color.new(color.red, 90) : na)
