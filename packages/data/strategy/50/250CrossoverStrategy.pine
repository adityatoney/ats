//@version=6
indicator("MA Crossover Strategy", overlay=true)

// Calculate moving averages
sma_50 = ta.sma(close, 50)
sma_250 = ta.sma(close, 250)
avg_volume_50 = ta.sma(volume, 50)

// Plot moving averages
plot(sma_50, color=color.blue, title="SMA 50", linewidth=2)
plot(sma_250, color=color.red, title="SMA 250", linewidth=2)

// Signal conditions
golden_cross = ta.crossover(sma_50, sma_250)
death_cross = ta.crossunder(sma_50, sma_250)
volume_confirmation = volume > 1.5 * avg_volume_50

// Buy signal: golden cross with volume confirmation
buy_signal = golden_cross and volume_confirmation

// Sell signal: death cross
sell_signal = death_cross

// Plot signals
plotshape(buy_signal, style=shape.triangleup, location=location.belowbar, 
          color=color.green, size=size.normal, title="Buy Signal")
plotshape(sell_signal, style=shape.triangledown, location=location.abovebar, 
          color=color.red, size=size.normal, title="Sell Signal")

// Background highlighting for signal bars
bgcolor(buy_signal ? color.new(color.green, 90) : na)
bgcolor(sell_signal ? color.new(color.red, 90) : na)

// Alert conditions
alertcondition(buy_signal, title="Buy Alert", message="Golden cross with volume confirmation")
alertcondition(sell_signal, title="Sell Alert", message="Death cross")

// Display current values in table
var table info_table = table.new(position.top_right, 3, 4, bgcolor=color.white, border_width=1)
if barstate.islast
    table.cell(info_table, 0, 0, "Indicator", text_color=color.black)
    table.cell(info_table, 1, 0, "Value", text_color=color.black)
    table.cell(info_table, 0, 1, "SMA 50", text_color=color.black)
    table.cell(info_table, 1, 1, str.tostring(sma_50, "#.##"), text_color=color.black)
    table.cell(info_table, 0, 2, "SMA 250", text_color=color.black)
    table.cell(info_table, 1, 2, str.tostring(sma_250, "#.##"), text_color=color.black)
    table.cell(info_table, 0, 3, "Vol Ratio", text_color=color.black)
    table.cell(info_table, 1, 3, str.tostring(volume / avg_volume_50, "#.##"), text_color=color.black)